@model IEnumerable<CSMS.Models.Car>

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Cars";
}

<div class="container mt-4">
    <h2 class="mb-3 text-center">@ViewData["Title"]</h2>

    <div class="mb-3 text-center">
        <a asp-action="Create" class="btn btn-success">Add New Car</a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var car in Model)
        {
            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@car.Brand @car.Model (@car.LicensePlate)</h5>
                        <p class="card-text mb-1"><strong>Year:</strong> @car.Year</p>
                        <p class="card-text mb-1"><strong>VIN:</strong> @car.Vin</p>
                        <p class="card-text mb-1"><strong>Engine:</strong> @car.EngineType</p>
                        <p class="card-text mb-1"><strong>Mileage:</strong> @car.Mileage</p>

                        <div class="mt-auto d-flex flex-wrap gap-1">
                            <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-danger">Delete</a>
                            <a asp-controller="RepairOrders" asp-action="History" asp-route-carId="@car.Id" class="btn btn-sm btn-primary">Repair History</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
