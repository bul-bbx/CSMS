@model CSMS.Models.Car

@{
    Layout = "_Layout";
    ViewData["Title"] = "Car Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">@Model.Brand @Model.Model (@Model.LicensePlate)</h3>

                    <dl class="row mb-3">
                        <dt class="col-sm-4">Brand</dt>
                        <dd class="col-sm-8">@Model.Brand</dd>

                        <dt class="col-sm-4">Model</dt>
                        <dd class="col-sm-8">@Model.Model</dd>

                        <dt class="col-sm-4">Year</dt>
                        <dd class="col-sm-8">@Model.Year</dd>

                        <dt class="col-sm-4">VIN</dt>
                        <dd class="col-sm-8">@Model.Vin</dd>

                        <dt class="col-sm-4">License Plate</dt>
                        <dd class="col-sm-8">@Model.LicensePlate</dd>

                        <dt class="col-sm-4">Engine Type</dt>
                        <dd class="col-sm-8">@Model.EngineType</dd>

                        <dt class="col-sm-4">Mileage</dt>
                        <dd class="col-sm-8">@Model.Mileage</dd>

                        <dt class="col-sm-4">Customer</dt>
                        <dd class="col-sm-8">@Model.Customer?.UserName</dd>
                    </dl>

                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                        <a asp-controller="RepairOrders" asp-action="History" asp-route-carId="@Model.Id" class="btn btn-info">Repair History</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
