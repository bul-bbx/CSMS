@model IEnumerable<CSMS.Models.Invoice>

<div class="container mt-4">
    <h1 class="text-center mb-4">Invoices</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No invoices found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-center">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Invoice Number</th>
                                <th>Customer</th>
                                <th>Issue Date</th>
                                <th>Due Date</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model.Select((value, index) => new { value, index }))
                            {
                                <tr>
                                    <td>@(inv.index + 1)</td>
                                    <td>@inv.value.InvoiceNumber</td>
                                    <td>@(inv.value.Customer?.UserName ?? "Unknown")</td>
                                    <td>@inv.value.IssueDate.ToString("yyyy-MM-dd")</td>
                                    <td>@inv.value.DueDate?.ToString("yyyy-MM-dd")</td>
                                    <td>@inv.value.TotalAmount.ToString("C")</td>
                                    <td>
                                        <span class="badge @(inv.value.Status == "Paid" ? "bg-success" : "bg-warning")">
                                            @inv.value.Status
                                        </span>
                                    </td>
                                    <td class="d-flex justify-content-center flex-wrap gap-1">
                                        <a asp-action="Details" asp-route-id="@inv.value.Id" asp-route-isMy="false" class="btn btn-sm btn-info">Details</a>
                                        @if (!string.IsNullOrEmpty(inv.value.PdfPath))
                                        {
                                            <a href="@inv.value.PdfPath" target="_blank" class="btn btn-sm btn-primary">PDF</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
