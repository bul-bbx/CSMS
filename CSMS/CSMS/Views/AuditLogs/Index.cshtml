@model IEnumerable<CSMS.Models.AuditLog>

<div class="container mt-4">
    <h1 class="text-center mb-4">Audit Logs</h1>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No audit logs found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered text-center">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>EntityId</th>
                                <th>IP</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.Select((value, index) => new { value, index }))
                            {
                                <tr>
                                    <td>@(log.index + 1)</td>
                                    <td>@log.value.User?.UserName</td>
                                    <td>@log.value.Action</td>
                                    <td>@log.value.EntityType</td>
                                    <td>@log.value.EntityId</td>
                                    <td>@log.value.IpAddress</td>
                                    <td>@log.value.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
