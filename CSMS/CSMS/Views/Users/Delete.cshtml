@model Microsoft.AspNetCore.Identity.IdentityUser

@{
    ViewData["Title"] = "Delete User";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <h1 class="text-center mb-3">Delete User</h1>
            <h5 class="text-center text-danger mb-4">
                Are you sure you want to delete this user?
            </h5>

            <div class="card shadow-sm">
                <div class="card-body">

                    <h5 class="card-title text-center mb-4">
                        @Model.UserName
                    </h5>

                    <dl class="row">
                        <dt class="col-sm-4">User name</dt>
                        <dd class="col-sm-8">@Model.UserName</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Phone number</dt>
                        <dd class="col-sm-8">@Model.PhoneNumber</dd>

                        <dt class="col-sm-4">Email confirmed</dt>
                        <dd class="col-sm-8">@Model.EmailConfirmed</dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="text-center mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <button type="submit" class="btn btn-danger">
                            Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            Back to List
                        </a>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
