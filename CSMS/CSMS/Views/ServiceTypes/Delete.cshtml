@model CSMS.Models.ServiceType

<h1 class="text-center mb-4 text-danger">Delete Service Type</h1>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm rounded border-danger">
            <div class="card-body">
                <h4 class="card-title text-danger">Are you sure you want to delete this?</h4>

                <p><strong>Name:</strong> @Model.Name</p>
                <p><strong>Base Price:</strong> @Model.BasePrice.ToString("C")</p>
                <p><strong>Estimated Duration:</strong> @Model.EstimatedDurationMinutes minutes</p>
                <p><strong>Description:</strong> @Model.Description</p>

                <form asp-action="DeleteConfirmed" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
