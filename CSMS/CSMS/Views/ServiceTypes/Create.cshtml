@model CSMS.Models.ViewModels.ServiceTypeViewModel

<h1 class="text-center mb-4">Create Service Type</h1>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm rounded">
            <div class="card-body">
                <h4 class="card-title text-center mb-3">Service Type Details</h4>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BasePrice" class="form-label"></label>
                        <input asp-for="BasePrice" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="BasePrice" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EstimatedDurationMinutes" class="form-label"></label>
                        <input asp-for="EstimatedDurationMinutes" type="number" class="form-control" />
                        <span asp-validation-for="EstimatedDurationMinutes" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-grid mt-3">
                        <button type="submit" class="btn btn-success">Create</button>
                        <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
