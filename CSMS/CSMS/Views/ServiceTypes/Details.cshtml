@model CSMS.Models.ServiceType

<h1 class="text-center mb-4">Service Type Details</h1>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm rounded">
            <div class="card-body">
                <h4 class="card-title">@Model.Name</h4>
                <p><strong>Base Price:</strong> @Model.BasePrice.ToString("C")</p>
                <p><strong>Estimated Duration:</strong> @Model.EstimatedDurationMinutes minutes</p>
                <p><strong>Description:</strong> @Model.Description</p>

                <div class="mt-3 d-flex gap-2 flex-wrap">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
