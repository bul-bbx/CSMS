@model IEnumerable<CSMS.Models.ServiceType>

<h1 class="text-center mb-4">Service Types</h1>

<div class="mb-3 text-center">
    <a asp-action="Create" class="btn btn-success">Add New Service Type</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="table-dark text-center">
            <tr>
                <th>Name</th>
                <th>Base Price</th>
                <th>Estimated Duration (min)</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var st in Model)
            {
                <tr>
                    <td>@st.Name</td>
                    <td>@st.BasePrice.ToString("C")</td>
                    <td>@st.EstimatedDurationMinutes</td>
                    <td>@st.Description</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@st.Id" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@st.Id" class="btn btn-primary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@st.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
