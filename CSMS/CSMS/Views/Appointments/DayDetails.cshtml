@model IEnumerable<CSMS.Models.Appointment>

@{
    Layout = "_Layout";
    ViewData["Title"] = $"Appointments for {((DateTime)ViewBag.Date).ToString("MMMM dd, yyyy")}";
    var date = (DateTime)ViewBag.Date;
}

<div class="container mt-4">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>

    <div class="d-flex justify-content-between mb-4">
        <a asp-action="Index" asp-route-year="@date.Year" asp-route-month="@date.Month" class="btn btn-outline-primary">&laquo; Back to Calendar</a>
        <a asp-action="Create" asp-route-date="@date.ToString("yyyy-MM-dd")" class="btn btn-success">Create Appointment</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No appointments for this day.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var appt in Model)
            {
                var statusBadgeClass = appt.Status switch
                {
                    "Completed" => "bg-success",
                    "Cancelled" => "bg-danger",
                    _ => "bg-secondary"
                };

                bool isInactive = appt.Status == "Completed" || appt.Status == "Cancelled";

                <div class="col">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">
                                @appt.Car.Brand @appt.Car.Model (@appt.Car.LicensePlate)
                            </h5>
                            <p class="card-text mb-1">
                                <strong>Service:</strong> @appt.ServiceType.Name
                            </p>
                            <p class="card-text mb-1">
                                <strong>Mechanic:</strong> @appt.Mechanic.UserName
                            </p>
                            <p class="card-text mb-1">
                                <strong>Start:</strong> @appt.StartTime.ToString(@"hh\:mm")
                                <strong> - End:</strong> @appt.EndTime.ToString(@"hh\:mm")
                            </p>
                            <p class="card-text mb-1">
                                <strong>Status:</strong>
                                <span class="badge @statusBadgeClass">@appt.Status</span>
                            </p>
                            <p class="card-text mb-3">
                                <strong>Notes:</strong> @appt.Notes
                            </p>

                            <div class="mt-auto text-center">
                                <a asp-action="Details" asp-route-id="@appt.Id" class="btn btn-sm btn-info me-1">
                                    Details
                                </a>

                                @if (!isInactive)
                                {
                                    <a asp-action="Edit" asp-route-id="@appt.Id" class="btn btn-sm btn-warning me-1">
                                        Edit
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted d-block mt-2">Locked</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
