@model CSMS.Models.Appointment

@{
    Layout = "_Layout";
    ViewData["Title"] = "Delete Appointment";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger rounded">
                <div class="card-body">

                    <h3 class="card-title text-center mb-4 text-danger">
                        Delete Appointment
                    </h3>
                    <h5 class="text-center text-danger mb-3">
                        Are you sure you want to delete this appointment?
                    </h5>

                    <dl class="row">
                        <dt class="col-sm-4">Car</dt>
                        <dd class="col-sm-8">@Model.Car?.Brand @Model.Car?.Model (@Model.Car?.LicensePlate)</dd>

                        <dt class="col-sm-4">Service</dt>
                        <dd class="col-sm-8">@Model.ServiceType?.Name</dd>

                        <dt class="col-sm-4">Date</dt>
                        <dd class="col-sm-8">@Model.AppointmentDate.ToShortDateString()</dd>

                        <dt class="col-sm-4">Time</dt>
                        <dd class="col-sm-8">
                            @Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")
                        </dd>

                        <dt class="col-sm-4">Mechanic</dt>
                        <dd class="col-sm-8">@Model.Mechanic?.UserName</dd>

                        <dt class="col-sm-4">Notes</dt>
                        <dd class="col-sm-8">@Model.Notes</dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="text-center mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <button type="submit" class="btn btn-danger w-100 mb-2">
                            Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary w-100">
                            Cancel
                        </a>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
